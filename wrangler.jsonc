/**
 * Static-assets-only Worker: every page is pre-rendered to HTML at build time
 * (see react-router.config.ts), so there is no server code to run.
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2025-04-04",
	"assets": {
		"directory": "./out",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
